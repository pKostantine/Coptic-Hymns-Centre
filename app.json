{
  "expo": {
    "name": "Coptic Vine",
    "slug": "Coptic-Hymns-Centre",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/coptic-vine-icon.png",
    "scheme": "coptichymnscentre",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/coptic-vine-icon.png",
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14301B",
        "foregroundImage": "./assets/images/coptic-vine-android-foreground.png",
        "backgroundImage": "./assets/images/coptic-vine-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pkostantine.CopticHymnsCentre"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/coptic-vine-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14301B",
          "image": "./assets/images/coptic-vine-seal.png",
          "imageWidth": 160
        }
      ],
      "expo-asset",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Coptic Vine to choose a profile or playlist cover photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aea4f18c-5f12-4986-abb6-47bf0955ab4a"
      }
    }
  }
}
