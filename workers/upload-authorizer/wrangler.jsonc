{
  "name": "chc-upload-authorizer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://wtuujmeinzqfikvuofmh.supabase.co",
    "MAX_UPLOAD_BYTES": "21474836480"
  },
  "r2_buckets": [
    {
      "binding": "CHC_SUBMISSIONS",
      "bucket_name": "chc-submissions"
    },
    {
      "binding": "CHC_MUSIC",
      "bucket_name": "chc-music"
    },
    {
      "binding": "CHC_LEARNING",
      "bucket_name": "chc-learning"
    },
    {
      "binding": "CHC_IMAGES",
      "bucket_name": "chc-images"
    }
  ]
}
