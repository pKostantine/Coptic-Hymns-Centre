{
  "name": "chc-media-resolver",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_CACHE_CONTROL": "public, max-age=31536000, immutable"
  },
  "r2_buckets": [
    {
      "binding": "MUSIC_BUCKET",
      "bucket_name": "chc-music"
    },
    {
      "binding": "LEARNING_BUCKET",
      "bucket_name": "chc-learning"
    },
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "chc-images"
    }
  ]
}
